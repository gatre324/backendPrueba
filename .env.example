APP_NAME=SI2 Nutricionista API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# FastAPI application connection. Encode reserved password characters.
DATABASE_POOL_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<DB_PASSWORD>@<POOLER_HOST>:6543/postgres
# Prefer Session/Direct Pooler for Alembic in shared environments.
DATABASE_MIGRATION_URL=

JWT_SECRET_KEY=generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:4200

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
